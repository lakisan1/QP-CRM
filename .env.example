# QP-CRM — per-app Flask secret keys (P0-T4 / P0-T5).
#
# Copy this file to .env and fill in ALL six values, one per sub-app:
#   cp .env.example .env
#
# Generate each value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# How these are used:
#   * docker compose injects them into the container via `env_file: .env`
#     (see docker-compose.yml).
#   * Bare-metal runs (run_apps.sh / python main.py) do NOT read .env —
#     they fall back to the in-code default keys in each sub-app
#     (pricing/, offer/, rent/, admin/, sale/, settings/).
#
# .env is already git-ignored — never commit real keys.

PRICING_SECRET_KEY=
OFFER_SECRET_KEY=
RENT_SECRET_KEY=
ADMIN_SECRET_KEY=
SALE_SECRET_KEY=
SETTINGS_SECRET_KEY=

# --- TLS / nginx reverse proxy (user decision, post-Phase-3) ---------------
# The app always listens on its own port 5000. When nginx fronts it with
# HTTPS + a domain, set the three values below in .env:
#
#   QP_HTTPS_ONLY=1      # ONLY behind the nginx TLS proxy:
#                        #  - app trusts X-Forwarded-* (werkzeug ProxyFix),
#                        #  - qp_session cookie is marked Secure (https only),
#                        #  - HSTS header on https responses.
#                        # Keep 0 (default) for plain LAN http.
#   QP_PUBLIC_DOMAIN=    # public domain nginx fronts, e.g. crm.example.com
#                        # (must match nginx `server_name`; informational)
#   QP_APP_BIND=         # host binding of the published :5000 port:
#                        # 0.0.0.0 = LAN-reachable (default, current setup);
#                        # 127.0.0.1 = only through nginx on this host
#                        # (set this once nginx is configured).
QP_HTTPS_ONLY=0
QP_PUBLIC_DOMAIN=
QP_APP_BIND=0.0.0.0
