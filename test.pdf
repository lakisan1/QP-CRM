<!doctype html>
<html lang="sr" data-theme="dark">
<head>
    <meta charset="utf-8">
    <title>Prijava – Zakup – QP-CRM</title>
    <link rel="icon" type="image/png" href="/app_assets/favicon.png">
    
    <link rel="stylesheet" href="/rent/static/css/main.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    
</head>
<body>

<nav>
    <div class="nav-links">
        <a href="/rent/contracts" >Ugovori</a>
        <a href="/rent/clients"   >Klijenti</a>
        <a href="/rent/equipment" >Oprema</a>
    </div>
    <div class="nav-right">
        <a href="/">Početna</a>
        <a href="/rent/logout" class="btn btn-danger" style="margin-right:15px;">Odjava</a>
        <div class="nav-logo-container">
            <img src="/rent/static/img/logo_company.jpg" alt="Logo" class="nav-logo">
        </div>
    </div>
</nav>
<hr>


<div style="max-width:380px;margin:80px auto;">
    <div class="card">
        <h2 style="text-align:center;margin-bottom:24px;">🔐 Zakup – Prijava</h2>
        
        <form method="post">
            <label>Lozinka</label>
            <input type="password" name="password" autofocus required style="margin-bottom:16px;">
            <button type="submit" class="btn btn-primary" style="width:100%;">Prijavi se</button>
        </form>
    </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.searchable-select').forEach(el => {
        new TomSelect(el, { create: false, sortField: { field: "text", direction: "asc" } });
    });
});
</script>


</body>
</html>